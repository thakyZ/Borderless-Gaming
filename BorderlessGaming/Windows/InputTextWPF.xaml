<Window x:Class="BorderlessGaming.Windows.InputTextWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:BorderlessGaming.Windows"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModel="clr-namespace:BorderlessGaming.Windows.ViewModels"
        Title="Input Text"
        Width="800"
        Height="450"
        d:DataContext="{d:DesignInstance viewModel:InputTextViewModel}"
        mc:Ignorable="d">
  <Grid>
    <Label Content="{Binding Path=Instructions}" />
    <TextBox Text="{Binding Path=Input}" />
    <Button Command="{Binding Path=OKButtonClicked}"
            Content="{Binding Path=OKButtonLabel}" />
    <Button Command="{Binding Path=CancelButtonClicked}"
            Content="{Binding Path=CancelButtonLabel}" />
  </Grid>
</Window>
